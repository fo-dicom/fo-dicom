namespace FellowOakDicom
{

    public partial class DicomTag
    {

<#
    var tags = GetTags();

    var vms = tags.Select(t => t.Value.Item6).Distinct().OrderBy(v => v).ToArray();
    foreach (var kv in tags)
    {
        var tag = kv.Value;
        var description = ToXmlValidDescription(tag.Item4);
        var tagType = "DicomTag" + tag.Item5.Replace("/", "");
        if (tag.Item6 != "1") {
           tagType = tagType + "s";
        }
#>
        ///<summary>(<#= tag.Item1 #>,<#= tag.Item2 #>) VR=<#= tag.Item5 #> VM=<#= tag.Item6 #> <#= description #><#= tag.Item7 ? " (RETIRED)" : "" #></summary>
        public readonly static <#= tagType #> <#= ToTagKeyword(tag.Item3, tag.Item7) #> = new <#= tagType #>(0x<#= ToStrictNumeric(tag.Item1) #>, 0x<#= ToStrictNumeric(tag.Item2) #>);

<#
    }
#>
    }
}
